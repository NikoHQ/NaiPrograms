#!/usr/bin/env bash
#
# nailyrics - letras de canciones para streams de radio (PyRadio y MPRIS en general)
#
# Los reproductores de radio no exponen xesam:artist / xesam:title por separado,
# sino un unico titulo con formato "Artista - Cancion". Este script normaliza eso
# y consulta LRCLIB (https://lrclib.net), una API libre y sin clave.

set -u

readonly TAB=$'\t'

readonly PROGNAME="nailyrics"
readonly VERSION="2.0.0"
readonly API="https://lrclib.net/api"

readonly RETRIES=3          # intentos de lectura de metadatos
readonly RETRY_DELAY=0.4    # segundos entre intentos
readonly MAX_HISTORY=1000   # maximo de entradas retenidas en el historial

# Solo se escribe dentro de este directorio (XDG cache del usuario).
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/$PROGNAME"
HISTORY_FILE="$CACHE_DIR/history.tsv"

# Candidatos cuando playerctl no reporta ningun reproducteur por --list-all
readonly FALLBACK_PLAYERS="pyradio mpv vlc cellarsound cmus deadbeef rhythmbox audacious spotify youtube-music brave chromium chromium-browser firefox qutebrowser"

# ---------------------------------------------------------------- presentacion

setup_colors() {
    if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
        C_RESET=$'\033[0m'; C_BOLD=$'\033[1m'; C_DIM=$'\033[2m'
        C_GREEN=$'\033[1;32m'; C_CYAN=$'\033[1;36m'; C_YELLOW=$'\033[1;33m'
        C_RED=$'\033[1;31m'
    else
        C_RESET=''; C_BOLD=''; C_DIM=''
        C_GREEN=''; C_CYAN=''; C_YELLOW=''; C_RED=''
    fi
}

die() { printf '%s%s:%s %s\n' "$C_RED" "$PROGNAME" "$C_RESET" "$1" >&2; exit 1; }

usage() {
    cat <<EOF
${C_BOLD}$PROGNAME v$VERSION${C_RESET} - letras de canciones para radios online

${C_BOLD}USO${C_RESET}
  $PROGNAME                          Detecta que se esta reproduciendo y muestra la letra
  $PROGNAME -s TITULO [ARTISTA]      Busca una cancion concreta (sin tocar el reproductor)
  $PROGNAME -last                    Muestra el ultimo titulo registrado
  $PROGNAME -list [N]                Lista el historial, del mas nuevo al mas viejo
  $PROGNAME -p REPRODUCTOR           Fuerza un reproductor especifico

${C_BOLD}OPCIONES${C_RESET}
  -s, --search TITULO [ARTISTA]  Busqueda manual. Si no indicas artista se busca solo por titulo.
                                 Un unico argumento con " - " se interpreta como "artista - titulo".
  -last, --last                 Ultimo titulo registrado (no consulta el reproductor).
  -list, --list [N]             Historial numerado, N lineas por defecto todas.
  -p, --player REPRODUCTOR      Fuerza el reproductor (por ejemplo: pyradio, mpv).
  -h, --help                    Esta ayuda.
  -V, --version                 Muestra la version.

${C_BOLD}EJEMPLOS${C_RESET}
  $PROGNAME
  $PROGNAME -s "What's Up" "4 Non Blondes"
  $PROGNAME -s "Bohemian Rhapsody"
  $PROGNAME -list 20
  $PROGNAME -p mpv

${C_BOLD}HISTORIAL${C_RESET}
  $HISTORY_FILE
  Se registra cada pista detectada, exista o no su letra.
EOF
}

# ------------------------------------------------------------------ utilidades

require_deps() {
    local dep missing=()
    for dep in playerctl curl jq; do
        command -v "$dep" >/dev/null 2>&1 || missing+=("$dep")
    done
    (( ${#missing[@]} > 0 )) && die "faltan dependencias: ${missing[*]}"
}

trim() {
    local s="$1"
    s="${s#"${s%%[![:space:]]*}"}"
    s="${s%"${s##*[![:space:]]}"}"
    printf '%s' "$s"
}

# Colapsa tabuladores y saltos de linea para no romper el formato TSV del historial
sanitize_field() {
    local s="$1"
    s="${s//$'\t'/ }"
    s="${s//$'\n'/ }"
    s="${s//$'\r'/ }"
    printf '%s' "$s"
}

# Parte una linea del historial en sus 4 campos (ts, player, artist, song).
# No se usa "IFS=$'\t' read" porque el tabulador cuenta como espacio en IFS y
# los campos vacios se colapsarian, desplazando artista y cancion.
# El ultimo campo absorbe cualquier tabulador restante del titulo.
split_history_line() {
    local line="$1" rest
    h_ts="${line%%"$TAB"*}"
    if [[ "$line" != *"$TAB"* ]]; then h_player=""; h_artist=""; h_song=""; return 0; fi
    rest="${line#*"$TAB"*}"
    h_player="${rest%%"$TAB"*}"
    if [[ "$rest" != *"$TAB"* ]]; then h_artist=""; h_song="$rest"; return 0; fi
    rest="${rest#*"$TAB"*}"
    h_artist="${rest%%"$TAB"*}"
    if [[ "$rest" != *"$TAB"* ]]; then h_song="$rest"; else h_song="${rest#*"$TAB"*}"; fi
    return 0
}

ensure_cache_dir() {
    [[ -d "$CACHE_DIR" ]] || mkdir -p "$CACHE_DIR" || die "no se pudo crear $CACHE_DIR"
    [[ -f "$HISTORY_FILE" ]] || : > "$HISTORY_FILE" || die "no se pudo crear $HISTORY_FILE"
}

# ---------------------------------------------------------------- reproductores

# Imprime "nombre<TAB>titulo" de cada reproductor activo (Playing con metadatos).
# Primero playerctl --list-all; si no devuelve nada, prueba la lista de respaldo.
active_players() {
    local -a players=()
    local p status title

    while IFS= read -r p; do
        [[ -n "$p" ]] && players+=("$p")
    done < <(playerctl --list-all 2>/dev/null)

    if (( ${#players[@]} == 0 )); then
        for p in $FALLBACK_PLAYERS; do
            status=$(playerctl -p "$p" status 2>/dev/null) || continue
            [[ -n "$status" ]] && players+=("$p")
        done
    fi

    for p in "${players[@]}"; do
        status=$(playerctl -p "$p" status 2>/dev/null)
        [[ "$status" == "Playing" ]] || continue
        title=$(read_title "$p") || continue
        printf '%s\t%s\n' "$p" "$title"
    done
}

# Placeholders que emiten los reproductores cuando la estacion no envia
# metadatos ICY. No son titulos de canciones, asi que se descartan.
is_placeholder() {
    local norm
    norm=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
    norm="${norm//[[:space:]]/}"
    case "$norm" in
        ""|title|notitle|notitleavailable|notavailable|titlenotavailable|\
        titlenotavailable2|unknown|n/a|na|-|--|untitled|sin_titulo|\
        sintitulo|titulo|track|tracknotavailable|unknowntitle|\
        notavailablefortrack|nometadata)
            return 0 ;;
    esac
    return 1
}

# Lectura de metadatos con reintentos: las radios vacian el titulo un instante
# al cambiar de pista, y una sola lectura falla a menudo por eso.
read_title() {
    local player="$1" raw="" i cleaned
    for (( i = 1; i <= RETRIES; i++ )); do
        raw=$(playerctl -p "$player" metadata xesam:title 2>/dev/null)
        if [[ -n "${raw//[[:space:]]/}" ]]; then
            cleaned=$(trim "$raw")
            is_placeholder "$cleaned" || { printf '%s' "$cleaned"; return 0; }
        fi
        (( i < RETRIES )) && sleep "$RETRY_DELAY"
    done
    return 1
}

# Si hay varios reproductores sonando, deja que el usuario elija.
choose_player() {
    local -a names=() titles=()
    local line p t choice attempts=0

    while IFS=$'\t' read -r p t; do
        names+=("$p"); titles+=("$t")
    done < <(active_players)

    if (( ${#names[@]} == 0 )); then
        return 1
    elif (( ${#names[@]} == 1 )); then
        printf '%s' "${names[0]}"
        return 0
    fi

    # Todo el menu va a stderr: en stdout queda solo el nombre del reproductor,
    # que es lo que el llamador captura con $(choose_player).
    printf '\n%s%sSe detectaron varios reproductores activos:%s\n' "$C_YELLOW" "$C_BOLD" "$C_RESET" >&2
    local i
    for (( i = 0; i < ${#names[@]}; i++ )); do
        printf '  %s%d)%s %s%-10s%s %s\n' \
            "$C_BOLD" "$(( i + 1 ))" "$C_RESET" "$C_CYAN" "${names[i]}" "$C_RESET" "${titles[i]}" >&2
    done

    if [[ ! -t 0 ]]; then
        # Sin terminal interactiva no se puede preguntar: se prioriza pyradio.
        for (( i = 0; i < ${#names[@]}; i++ )); do
            if [[ "${names[i]}" == "pyradio" ]]; then
                printf '%s%s: sin terminal, usando pyradio (usa -p para forzar otro).%s\n' \
                    "$C_DIM" "$PROGNAME" "$C_RESET" >&2
                printf '%s' "${names[i]}"
                return 0
            fi
        done
        printf '%s' "${names[0]}"
        return 0
    fi

    while (( attempts < 5 )); do
        printf '\nSelecciona una opcion [1]: ' >&2
        if ! IFS= read -r choice; then
            printf '\n' >&2
            return 1
        fi
        choice="$(trim "${choice:-1}")"
        [[ -z "$choice" ]] && choice=1
        if [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#names[@]} )); then
            printf '%s' "${names[$(( choice - 1 ))]}"
            return 0
        fi
        printf '%sOpcion no valida. Introduce un numero entre 1 y %d.%s\n' \
            "$C_YELLOW" "${#names[@]}" "$C_RESET" >&2
        (( attempts++ ))
    done
    printf '%sDemasiados intentos fallidos.%s\n' "$C_YELLOW" "$C_RESET" >&2
    return 1
}

# ------------------------------------------------------------------- historial

# Append-only: timestamp, reproductor, artista, cancion. Evita reescribir el
# archivo entero en cada llamada; solo se trunca al superar MAX_HISTORY.
save_history() {
    local player="$1" artist="$2" song="$3"
    local last_key="" new_key

    ensure_cache_dir

    [[ -s "$HISTORY_FILE" ]] && last_key=$(awk -F'\t' 'END{print $3"\t"$4}' "$HISTORY_FILE" 2>/dev/null)
    new_key="$(sanitize_field "$artist")	$(sanitize_field "$song")"
    # No repetir la misma pista consecutivamente: al ejecutar el script varias
    # veces durante la misma canción el historial no debe llenarse de duplicados.
    [[ "$last_key" == "$new_key" ]] && return 0

    printf '%s\t%s\t%s\t%s\n' \
        "$(date '+%Y-%m-%d %H:%M:%S')" \
        "$(sanitize_field "$player")" \
        "$(sanitize_field "$artist")" \
        "$(sanitize_field "$song")" >> "$HISTORY_FILE" || return 1

    local lines
    lines=$(wc -l < "$HISTORY_FILE" 2>/dev/null || echo 0)
    if (( lines > MAX_HISTORY )); then
        local tmp
        tmp=$(mktemp "$CACHE_DIR/.history.XXXXXX") || return 0
        tail -n "$MAX_HISTORY" "$HISTORY_FILE" > "$tmp" && mv -f "$tmp" "$HISTORY_FILE"
        rm -f "$tmp"
    fi
    return 0
}

cmd_last() {
    ensure_cache_dir
    if [[ ! -s "$HISTORY_FILE" ]]; then
        printf '%sEl historial esta vacio.%s\n' "$C_YELLOW" "$C_RESET"
        return 1
    fi
    local h_ts="" h_player="" h_artist="" h_song=""
    split_history_line "$(tail -n 1 "$HISTORY_FILE")"
    printf '%s[%s]%s %s%s%s de %s%s%s\n' \
        "$C_DIM" "${h_ts:-?}" "$C_RESET" \
        "$C_GREEN" "${h_song:-${h_artist:-?}}" "$C_RESET" \
        "$C_CYAN" "${h_artist:-(sin artista)}" "$C_RESET"
    [[ -n "$h_player" ]] && printf '%s(reproductor: %s)%s\n' "$C_DIM" "$h_player" "$C_RESET"
    return 0
}

cmd_list() {
    local limit="${1:-}"
    ensure_cache_dir

    if [[ ! -s "$HISTORY_FILE" ]]; then
        printf '%sEl historial esta vacio.%s\n' "$C_YELLOW" "$C_RESET"
        return 1
    fi

    local -a lines=()
    while IFS= read -r line; do
        [[ -n "$line" ]] && lines+=("$line")
    done < "$HISTORY_FILE"

    local total=${#lines[@]} start n=1 i
    local h_ts="" h_player="" h_artist="" h_song=""
    if [[ -n "$limit" ]]; then
        [[ "$limit" =~ ^[0-9]+$ ]] || die "el limite debe ser un numero entero"
        start=$(( total - limit )); (( start < 0 )) && start=0
    else
        start=0
    fi

    printf '%sHistorial (%d entradas, del mas nuevo al mas viejo)%s\n' "$C_BOLD" "$total" "$C_RESET"
    for (( i = total - 1; i >= start; i-- )); do
        split_history_line "${lines[i]}"
        printf '%s%3d.%s %s%s%s  %s%s%s de %s%s%s\n' \
            "$C_BOLD" "$(( n++ ))" "$C_RESET" \
            "$C_DIM" "${h_ts:-?}" "$C_RESET" \
            "$C_GREEN" "${h_song:-${h_artist:-?}}" "$C_RESET" \
            "$C_CYAN" "${h_artist:-(sin artista)}" "$C_RESET"
    done
    return 0
}

# -------------------------------------------------------------------- LRCLIB

readonly JQ_RANK='
def norm: ascii_downcase | gsub("[^a-z0-9]+"; " ") | sub("^ +"; "") | sub(" +$"; "");
def toks: norm | split(" ") | map(select(length > 0));
def coverage($needle; $hay):
  ($needle | length) as $n
  | if $n == 0 then 0
    else ([ $needle[] as $t | select($hay | index($t)) ] | length) / $n end;
def field_score($want; $got):
  ($want | norm) as $w | ($got | norm) as $g
  | if ($w | length) == 0 then 0
    elif $w == $g then 100
    else (coverage($w | toks; $g | toks) * 80 | floor) end;
def score($song; $artist):
  (.trackName // "" | field_score($song; .)) as $ts
  | (.artistName // "" | field_score($artist; .)) as $as
  | { t: $ts,
      total: ($ts + ($as * 0.6) + (if .plainLyrics then 8 else 0 end) - (if .instrumental then 5000 else 0 end)) };
map(. + {r: score($song; $artist)})
| map(select(.r.t >= 50))
| sort_by(-.r.total, .duration // 0)
| .[0:5]
| map({ track: (.trackName // ""), artist: (.artistName // ""), album: (.albumName // ""), plain: (.plainLyrics // ""), synced: (.syncedLyrics // "") })
'

# Quita marcas de tiempo [mm:ss.cc] de una letra sincronizada.
readonly JQ_UNSYNC='(.plain // "") as $p
  | if ($p | length) > 0 then $p
    else ((.synced // "") | gsub("\\[[0-9]+:[0-9]{1,2}(\\.[0-9]+)?\\]"; "")) end'

# Normaliza la respuesta de /api/get a la misma forma que usa JQ_RANK.
readonly JQ_FROM_GET='if (.trackName // "") != "" then
  [{ track: (.trackName // ""), artist: (.artistName // ""), album: (.albumName // ""),
     plain: (.plainLyrics // ""), synced: (.syncedLyrics // "") }]
  else [] end'

# Extrae el primer candidato de un array normalizado (o {} si no hay).
readonly JQ_FIRST='(.[0] // {})'

# Rellena FETCH_TRACK / FETCH_ARTIST / FETCH_LYRICS a partir de una respuesta ya
# normalizada. Devuelve 1 si no hay letra utilizable.
_read_normalized() {
    local json="$1"
    [[ -n "$json" ]] || return 1
    FETCH_TRACK=$(printf '%s' "$json" | jq -r "$JQ_FIRST | .track // empty" 2>/dev/null) || return 1
    FETCH_ARTIST=$(printf '%s' "$json" | jq -r "$JQ_FIRST | .artist // empty" 2>/dev/null) || return 1
    FETCH_LYRICS=$(printf '%s' "$json" | jq -r "$JQ_FIRST | $JQ_UNSYNC" 2>/dev/null) || return 1
    FETCH_LYRICS="${FETCH_LYRICS%$'\n'}"
    [[ -n "$FETCH_LYRICS" ]] || return 1
    return 0
}

fetch_lyrics() {
    local artist="$1" song="$2" resp=""

    # 1) Coincidencia exacta cuando conocemos el artista.
    if [[ -n "$artist" ]]; then
        resp=$(curl -sS --connect-timeout 5 --max-time 10 \
            --get --data-urlencode "artist_name=$artist" --data-urlencode "track_name=$song" \
            "${API}/get" 2>/dev/null) || resp=""
        resp=$(printf '%s' "$resp" | jq -c "$JQ_FROM_GET" 2>/dev/null) || resp=""
        if _read_normalized "$resp"; then
            return 0
        fi
    fi

    # 2) Busqueda difusa, puntuada: /search devuelve hasta 20 resultados y el
    #    primero no siempre es la cancion correcta.
    resp=$(curl -sS --connect-timeout 5 --max-time 10 \
        --get --data-urlencode "q=$artist $song" "${API}/search" 2>/dev/null) || resp=""
    resp=$(printf '%s' "$resp" | jq -c --arg song "$song" --arg artist "$artist" "$JQ_RANK" 2>/dev/null) || resp=""

    _read_normalized "$resp"
}

display_lyrics() {
    local song="$1" artist="$2" lyrics="$3"

    printf '\n%s🎵 Buscando letra para:%s %s%s%s de %s%s%s\n' \
        "$C_BOLD" "$C_RESET" "$C_GREEN" "$song" "$C_RESET" "$C_CYAN" "$artist" "$C_RESET"
    printf -- '------------------------------------------------\n'
    if [[ -n "$lyrics" ]]; then
        printf '%s\n' "$lyrics"
    else
        printf '%s❌ No se encontro la letra exacta.%s\n' "$C_RED" "$C_RESET"
    fi
    printf -- '------------------------------------------------\n\n'
}

# ---------------------------------------------------------------------Lyrics

show_for() {
    local artist="$1" song="$2"
    local FETCH_TRACK="" FETCH_ARTIST="" FETCH_LYRICS=""

    if fetch_lyrics "$artist" "$song"; then
        display_lyrics "$song" "$artist" "$FETCH_LYRICS"
        if [[ -n "$FETCH_TRACK" ]] && \
           [[ "$(printf '%s' "$FETCH_TRACK" | tr '[:upper:]' '[:lower:]')" != "$(printf '%s' "$song" | tr '[:upper:]' '[:lower:]')" ]]; then
            printf '%sNota: la API devolvio "%s - %s".%s\n' \
                "$C_DIM" "$FETCH_ARTIST" "$FETCH_TRACK" "$C_RESET"
        fi
        return 0
    fi

    display_lyrics "$song" "$artist" ""
    return 1
}

run_detect() {
    local forced="${1:-}" player="" raw artist song

    if [[ -n "$forced" ]]; then
        playerctl -p "$forced" status >/dev/null 2>&1 \
            || die "el reproductor '$forced' no esta activo"
        player="$forced"
        raw=$(read_title "$player") || die "no se pudo leer el titulo de '$player'"
    else
        player=$(choose_player) || die "no se detecta musica en ningun reproductor."
        raw=$(read_title "$player") || die "no se pudo leer el titulo de '$player'"
    fi

    # "Artista - Cancion" -> primer separador. Si no hay, todo es el titulo.
    if [[ "$raw" == *" - "* ]]; then
        artist="$(trim "${raw%% - *}")"
        song="$(trim "${raw#* - }")"
        # Separador al final ("Trailing - "): no hay cancion real, se usa todo.
        if [[ -z "$song" ]]; then
            artist=""
            song="$raw"
        fi
    else
        artist=""
        song="$raw"
    fi
    [[ -z "$song" ]] && song="$raw"

    save_history "$player" "$artist" "$song" || printf '%saviso: no se pudo guardar el historial%s\n' "$C_DIM" "$C_RESET" >&2

    show_for "$artist" "$song"
}

main() {
    setup_colors
    require_deps

    if (( $# == 0 )); then
        run_detect ""
        exit $?
    fi

    local forced="" arg
    while (( $# > 0 )); do
        arg="$1"
        case "$arg" in
            -h|--help)
                usage; exit 0 ;;
            -V|--version)
                printf '%s%s v%s%s\n' "$C_BOLD" "$PROGNAME" "$VERSION" "$C_RESET"; exit 0 ;;
            -last|--last)
                cmd_last; exit $? ;;
            -list|--list)
                if [[ -n "${2:-}" && "${2:0:1}" != "-" ]]; then cmd_list "$2"; shift; else cmd_list ""; fi
                exit $? ;;
            -s|--search)
                if [[ -z "${2:-}" ]]; then die "$arg requiere un titulo"; fi
                local title="$2" artist="${3:-}"
                shift
                if [[ -n "$artist" ]]; then
                    shift
                elif [[ "$title" == *" - "* ]]; then
                    artist="$(trim "${title%% - *}")"
                    title="$(trim "${title#* - }")"
                fi
                shift
                show_for "$artist" "$title"
                exit $? ;;
            -p|--player)
                [[ -n "${2:-}" ]] || die "$arg requiere un nombre de reproductor"
                forced="$2"; shift; shift ;;
            -*)
                printf '%sOpcion desconocida: %s%s\n' "$C_YELLOW" "$arg" "$C_RESET" >&2
                usage >&2
                exit 1 ;;
            *)
                printf '%s%s: se esperaba una opcion (usa -h).%s\n' "$C_YELLOW" "$PROGNAME" "$C_RESET" >&2
                exit 1 ;;
        esac
    done

    run_detect "$forced"
    exit $?
}

main "$@"